# fluent — API configuration
# Uncomment and paste keys. Everything works without them (mock stories, browser voices).

# Story/scenario generation (Anthropic preferred if both set):
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional: override the LLM (defaults: claude-sonnet-4-5 / gpt-4o-mini)
# LLM_MODEL=

# High-quality text-to-speech (needs OPENAI_API_KEY above; audio cached in data/tts/):
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=nova
